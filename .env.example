NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only Supabase key for admin scripts and contact form fail-safe writes.
# Prefer SUPABASE_SERVICE_ROLE_KEY; NEXT_SUPABASE_SERVICE_ROLE_KEY is supported as an alias.
SUPABASE_SERVICE_ROLE_KEY=
# NEXT_SUPABASE_SERVICE_ROLE_KEY=

# Google AI API Key for Chatbot (server-side only - do NOT use NEXT_PUBLIC_ prefix)
# Get API key from: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Optional: Chat API limiter tuning (defaults: 40 requests / 60000ms)
CHAT_RATE_LIMIT_MAX=40
CHAT_RATE_LIMIT_WINDOW_MS=60000

# Email configuration (Resend)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=
# Email address to receive contact form submissions
# Resend testing mode note: without a verified domain, this must be your Resend account inbox.
CONTACT_EMAIL=
# Sender email (default: onboarding@resend.dev for testing, use verified domain for production)
SENDER_EMAIL=
# Optional toggle for contact email notifications (default: true)
# Set to false to store messages in Supabase without sending email notifications.
CONTACT_EMAIL_NOTIFICATIONS=true

# Optional: Site URL for SEO

# Optional: Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Browser RUM toggle (default true)
NEXT_PUBLIC_ENABLE_RUM=true

# Optional: Error tracking webhook (Sentry alternative sink)
ERROR_TRACKING_WEBHOOK_URL=
ERROR_TRACKING_WEBHOOK_TOKEN=

# Optional: Log aggregation sink
LOG_INGEST_URL=
LOG_INGEST_TOKEN=

# Optional: RUM forwarding sink
RUM_INGEST_URL=
RUM_INGEST_TOKEN=

# Optional: SSL validation threshold in days
SSL_MIN_DAYS=14