{
  "name": "bathala-enterprises",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "dev:webpack": "node ./node_modules/next/dist/bin/next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:ci": "node ./node_modules/eslint/bin/eslint.js src",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test:critical-flows": "node ./node_modules/playwright/cli.js test tests/qa/critical-flows.spec.ts --config=playwright.critical.config.ts",
    "check:env": "node scripts/predeploy/verify-environment.mjs",
    "check:external": "node scripts/predeploy/check-external-connections.mjs",
    "check:ssl": "node scripts/predeploy/validate-ssl.mjs",
    "check:predeploy": "node scripts/predeploy/predeploy-checklist.mjs",
    "check:contact-email": "node scripts/predeploy/test-contact-email-delivery.mjs",
    "check:analytics": "node scripts/predeploy/verify-analytics-tracking.mjs",
    "lighthouse:production": "node ./node_modules/@lhci/cli/src/cli.js autorun --config=.lighthouserc.production.json",
    "icons:subset": "node ./scripts/generate-icon-subset.mjs",
    "test:a11y": "node ./node_modules/playwright/cli.js test --config=playwright.qa.config.ts tests/qa/accessibility.spec.ts --project=qa-a11y-chromium",
    "test:qa": "node ./node_modules/playwright/cli.js test --config=playwright.qa.config.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.101.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.12",
    "next": "^16.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.72.0",
    "resend": "^6.9.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
